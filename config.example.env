# Copy to config.env and edit. build.sh bakes these into the app's Info.plist;
# install-agent.sh uses them to write the launch agent.

APP_NAME="Zomboid Server Monitor"
BUNDLE_ID="io.github.lilpzmods.zomboid-server-monitor"
# launchd label for the agent that keeps the app running.
AGENT_LABEL="io.github.lilpzmods.zomboid-server-monitor"

# Folder the watch command runs in. Relative paths below resolve against it.
WORK_DIR="$HOME/pz-server"

# The command that watches for Workshop updates and never exits.
# Separate arguments with "|" (so paths with spaces work).
WATCH_COMMAND="/opt/homebrew/bin/node|native-server.mjs|watch"

# Where the watch command's output goes.
LOG_FILE="runtime-logs/native-watch.log"

# Optional JSON status file the watcher writes after each check (see README).
STATUS_FILE="runtime-logs/workshop-sync.json"

# "USR1" if your watch command checks right away on SIGUSR1 ("Check Now" then
# signals it). Empty: "Check Now" restarts the watch command instead.
CHECK_SIGNAL="USR1"

# Optional command for "Turn Watcher Off". Empty = launchctl disable + bootout.
OFF_COMMAND=""
